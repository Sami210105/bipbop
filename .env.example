# Copy this file to `.env` (same folder as serve.py) and fill in a key.
# `.env` is gitignored, so your key is never committed.
#
# A real environment variable always wins over this file, so
# $env:GEMINI_API_KEY = "..." in PowerShell still overrides what is here.

# Free key from Google AI Studio - https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here
# AIR_PIANO_GEMINI_MODEL=gemini-flash-lite-latest   # the default; pin another if you like

# Free key from Groq - https://console.groq.com/keys
# GROQ_API_KEY=your-key-here

# Free key from OpenRouter - https://openrouter.ai/keys
# OPENROUTER_API_KEY=your-key-here

# Optional: other knobs (see the README's "AI song lookup")
# AIR_PIANO_LLM=ollama            # try the local model first instead of the cloud
# AIR_PIANO_LLM=off               # no lookup at all, built-in songs only
# AIR_PIANO_OLLAMA_MODEL=qwen2.5:7b
# AIR_PIANO_LLM_TIMEOUT=90        # seconds to wait per model
